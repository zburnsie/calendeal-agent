# LLM for the chat agent, rerank, and local deal extraction (calendeal/llm.py).
# Default is DeepSeek's cheap model. Get a key at platform.deepseek.com (pay as you go).
CALENDEAL_LLM=deepseek:deepseek-flash
DEEPSEEK_API_KEY=
# Alternatives: CALENDEAL_LLM=anthropic:claude-haiku-4-5 (+ ANTHROPIC_API_KEY, pip install langchain-anthropic)
#               CALENDEAL_LLM=ollama:qwen2.5:7b (local, free; pip install langchain-ollama)
# Without any key the app still runs: picks use retrieval order and chat shows search results.

# Optional: LangSmith tracing (same as the labs), useful for docs/EVALUATION.md
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=calendeal

# Link-safety middleware (free key at virustotal.com; 4 requests/min, 500/day, non-commercial use)
VIRUSTOTAL_API_KEY=

# Calendar output
CALENDEAL_CALENDAR_NAME=CalenDeal Agent
CALENDEAL_TIMEZONE=America/Denver
# Minutes before a deal starts to show the reminder
CALENDEAL_REMINDER_MINUTES=720

# Sources
CALENDEAL_LOCATION=Provo, UT
# Set to 1 to include LLM web search for local deals in every fetch / snapshot (costs a few LLM calls)
CALENDEAL_LOCAL_SEARCH=0
# RSS deals have no end date; assume they last this many days
CALENDEAL_RSS_DEAL_DAYS=7

# Semantic search model (sentence-transformers)
CALENDEAL_EMBED_MODEL=all-MiniLM-L6-v2

# Web app demo helpers
# Pretend today is this date (so an old snapshot's deals aren't "expired" in a demo)
# CALENDEAL_TODAY=2026-11-22
# Sources the app uses when there's no snapshot yet
# CALENDEAL_APP_SOURCES=sample,slickdeals,local_search
